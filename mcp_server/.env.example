# ─────────────────────────────────────────────
# BizboxA MCP Server 환경변수
# ─────────────────────────────────────────────

# JWT 서명 키 (운영 환경에서 반드시 변경하세요)
JWT_SECRET=bizbox-mcp-secret-change-in-production

# Access Token 유효 시간 (시간 단위)
JWT_EXPIRE_HOURS=1

# 서버 바인딩 설정
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000

# OAuth 메타데이터에 사용되는 외부 접근 가능 기본 URL
# 로컬: http://localhost:8000
# 원격 배포 시: https://your-domain.com
MCP_SERVER_BASE=http://localhost:8000
